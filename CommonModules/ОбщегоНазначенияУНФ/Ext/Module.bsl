// Возвращает ссылку на валюту учета из константы НациональнаяВалюта.
Функция _ПолучитьВалютуУчета() Экспорт

    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ
        |   НациональнаяВалюта.Значение КАК Валюта
        |ИЗ
        |   Константа.НациональнаяВалюта КАК НациональнаяВалюта";

    Выборка = Запрос.Выполнить().Выбрать();

    Если Выборка.Следующий() Тогда
        Возврат Выборка.Валюта;
    КонецЕсли;

    Возврат Справочники.Валюты.ПустаяСсылка();

КонецФункции

